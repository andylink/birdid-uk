# birdid-uk-dashboard.service — FastAPI dashboard + SvelteKit frontend
#
# Installed automatically by install.sh --systemd.
# Manual install:
#   sudo cp systemd/birdid-uk-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now birdid-uk-dashboard.service
#
# Paths are patched by install.sh — do not edit /opt/birdid-uk directly.

[Unit]
Description=BirdID-UK — FastAPI dashboard
After=network.target birdid-uk-capture.service
PartOf=birdid-uk.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/birdid-uk
ExecStart=/opt/birdid-uk/venv/bin/uvicorn \
    dashboard.app:app \
    --host 0.0.0.0 \
    --port 8080
Restart=on-failure
RestartSec=5

User=BIRDID_USER

NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=birdid-uk-dashboard

[Install]
WantedBy=birdid-uk.target
