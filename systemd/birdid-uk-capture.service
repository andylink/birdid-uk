# birdid-uk-capture.service — real-time audio capture and BirdNET inference
#
# Installed automatically by install.sh --systemd.
# Manual install:
#   sudo cp systemd/birdid-uk-capture.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now birdid-uk-capture.service
#
# Paths are patched by install.sh — do not edit /opt/birdid-uk directly.

[Unit]
Description=BirdID-UK — audio capture and inference
After=network.target sound.target
PartOf=birdid-uk.target
# Give the audio device a moment to settle after a crash before retrying.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/birdid-uk
ExecStart=/opt/birdid-uk/venv/bin/python detect.py
Restart=on-failure
RestartSec=10

# Run as the deploying user so it can access the audio device and write to
# data/.  Replace with a dedicated service account if desired.
User=BIRDID_USER

# Load CUDA runtime library path if pip-installed CUDA packages are present
# (generated by install.sh — the "-" prefix means "ignore if missing").
EnvironmentFile=-/opt/birdid-uk/cuda.env

# Allow real-time audio scheduling (useful on RPi with low-latency kernels).
AmbientCapabilities=CAP_SYS_NICE
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=birdid-uk-capture

[Install]
WantedBy=birdid-uk.target
