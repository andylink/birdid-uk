# birddetector-dashboard.service — FastAPI dashboard + SvelteKit frontend
#
# Installed automatically by install.sh --systemd.
# Manual install:
#   sudo cp systemd/birddetector-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now birddetector-dashboard.service
#
# Paths are patched by install.sh — do not edit /opt/birdid-uk directly.

[Unit]
Description=BirdID-UK — FastAPI dashboard
After=network.target birddetector-capture.service
PartOf=birddetector.target

[Service]
Type=simple
WorkingDirectory=/opt/birdid-uk
ExecStart=/opt/birdid-uk/venv/bin/uvicorn \
    dashboard.app:app \
    --host 0.0.0.0 \
    --port 8080
Restart=on-failure
RestartSec=5

StartLimitIntervalSec=60
StartLimitBurst=5

User=%i

NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=birddetector-dashboard

[Install]
WantedBy=birddetector.target
